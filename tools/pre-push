#!/bin/sh
# Installed by `make hooks`: runs the secret scan on everything about to be pushed (Phase 5 review item 10).
zero=0000000000000000000000000000000000000000
ranges=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then ranges="$ranges --range $local_sha"; else ranges="$ranges --range $remote_sha..$local_sha"; fi
done
exec python3 "$(git rev-parse --show-toplevel)/tools/secret_scan.py" $ranges
