# Copy to backend/.env (gitignored) and fill in. Never commit real keys or paste them into chat or logs.
# `make hooks` installs a pre-push secret scan; `make secret-scan` runs it by hand.
DATABASE_URL=postgresql+psycopg://hisaab:hisaab@localhost:55432/hisaab
REDIS_URL=redis://localhost:6379/0
EVENT_BUS=redis              # redis | inprocess
DEMO_MODE=1
HISAAB_SEED=20260920
# HISAAB_CLOCK=2026-09-20    # pin the clock (the demo sets it per replay step)

# The copilot's provider for `hisaab ask` and the app. none = templates, always works
LLM_PROVIDER=none            # anthropic | openai_compat | none
LLM_MODEL=                   # required when LLM_PROVIDER != none; never hardcoded
LLM_BASE_URL=                # openai_compat only (Groq, Cerebras, OpenRouter, ...)
LLM_API_KEY=
LLM_TIMEOUT_S=20             # per LLM call
LLM_EFFORT=low               # Anthropic effort; numbers come from tools, so no long thinking
COPILOT_DEADLINE_S=20        # per question; set from the live eval's p95

# Keys for `hisaab eval-copilot --candidates` (backend/config/copilot.yaml: eval_candidates), read by name
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
